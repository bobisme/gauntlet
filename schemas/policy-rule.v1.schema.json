{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scourge.invalid/schemas/policy-rule.v1.schema.json",
  "title": "Scourge policy rule",
  "description": "One expected-access rule for one declared property of one engagement revision. The rule records where it came from and who admitted it. Shape validation establishes no admission and no authority: only the operator can admit a rule against the bound engagement.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "scourge.policy-rule.v1"
    },
    "property": {
      "$ref": "#/$defs/label"
    },
    "target_version": {
      "$ref": "#/$defs/version_ref"
    },
    "readers": {
      "$ref": "#/$defs/audience"
    },
    "writers": {
      "$ref": "#/$defs/audience"
    },
    "policy": {
      "$ref": "#/$defs/prose"
    },
    "source": {
      "oneOf": [
        {
          "$ref": "#/$defs/source_engagement"
        },
        {
          "$ref": "#/$defs/source_document"
        },
        {
          "$ref": "#/$defs/source_operator"
        },
        {
          "$ref": "#/$defs/source_inferred"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "property",
    "source"
  ],
  "anyOf": [
    {
      "required": [
        "readers"
      ]
    },
    {
      "required": [
        "writers"
      ]
    }
  ],
  "if": {
    "properties": {
      "source": {
        "properties": {
          "kind": {
            "enum": [
              "engagement",
              "document",
              "operator"
            ]
          }
        }
      }
    }
  },
  "then": {
    "required": [
      "target_version"
    ]
  },
  "$defs": {
    "label": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
    },
    "prose": {
      "type": "string",
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])",
      "maxLength": 4096
    },
    "audience": {
      "enum": [
        "owner",
        "group",
        "authenticated",
        "public"
      ]
    },
    "version_ref": {
      "type": "string",
      "pattern": "^version(?:\\.[a-z0-9][a-z0-9-]{0,31}){1,6}(?![\\s\\S])"
    },
    "artifact_ref": {
      "type": "string",
      "pattern": "^artifact(?:\\.[a-z0-9][a-z0-9-]{0,31}){1,6}(?![\\s\\S])"
    },
    "operator_ref": {
      "type": "string",
      "pattern": "^operator(?:\\.[a-z0-9][a-z0-9-]{0,31}){1,6}(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/artifact_ref"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/artifact_ref"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "selector": {
          "$ref": "#/$defs/byte_range"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "selector"
      ]
    },
    "byte_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "byte_range"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "start",
        "end"
      ]
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/operator_ref"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
        },
        "identity": {
          "enum": [
            "attributed",
            "authenticated"
          ]
        }
      },
      "required": [
        "actor",
        "recorded_at",
        "identity"
      ]
    },
    "source_engagement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "engagement"
        },
        "revision": {
          "$ref": "#/$defs/artifact"
        },
        "admission": {
          "$ref": "#/$defs/admission"
        }
      },
      "required": [
        "kind",
        "revision",
        "admission"
      ]
    },
    "source_document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "document"
        },
        "citation": {
          "$ref": "#/$defs/citation"
        },
        "admission": {
          "$ref": "#/$defs/admission"
        }
      },
      "required": [
        "kind",
        "citation",
        "admission"
      ]
    },
    "source_operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "operator"
        },
        "statement": {
          "$ref": "#/$defs/artifact"
        },
        "admission": {
          "$ref": "#/$defs/admission"
        }
      },
      "required": [
        "kind",
        "statement",
        "admission"
      ]
    },
    "source_inferred": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "inferred"
        },
        "citation": {
          "$ref": "#/$defs/citation"
        }
      },
      "required": [
        "kind"
      ]
    }
  }
}
