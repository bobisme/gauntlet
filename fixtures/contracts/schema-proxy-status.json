{
  "argv": [
    "--json",
    "schema",
    "proxy",
    "status"
  ],
  "exit_code": 0,
  "output": {
    "advice": [
      {
        "command": "teapot proxy status --help",
        "level": "info",
        "message": "teapot proxy status --help",
        "type": "next"
      }
    ],
    "schema": {
      "arguments": {
        "$defs": {
          "NoArgs": {
            "additionalProperties": false,
            "description": "Arguments of a command that takes none.",
            "type": "object"
          }
        },
        "$ref": "#/$defs/NoArgs"
      },
      "command": "proxy status",
      "destructive": 1,
      "effect": "read-only",
      "error": {
        "$defs": {
          "Advice": {
            "description": "One advice entry: a level, a short kebab-case `type` for programs to match\non, a message, and optionally the one command that follows it up.",
            "properties": {
              "command": {
                "description": "The command that acts on this advice, if any.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "level": {
                "$ref": "#/$defs/AdviceLevel",
                "description": "Level."
              },
              "message": {
                "description": "One line for people. For `next`, the command itself.",
                "type": "string"
              },
              "type": {
                "description": "Stable kebab-case identifier: `next`, `guessed-scope`, `gate-failed`.",
                "type": "string"
              }
            },
            "required": [
              "level",
              "type",
              "message"
            ],
            "type": "object"
          },
          "AdviceLevel": {
            "description": "How much an advice entry matters.",
            "oneOf": [
              {
                "const": "info",
                "description": "Something to know or do next.",
                "type": "string"
              },
              {
                "const": "warn",
                "description": "Something probably wrong or guessed.",
                "type": "string"
              },
              {
                "const": "error",
                "description": "Something failed (a gate, a partial batch).",
                "type": "string"
              }
            ]
          },
          "ErrorBody": {
            "description": "The value under `error` in an error envelope. Published by `teapot schema`.",
            "properties": {
              "code": {
                "$ref": "#/$defs/Exit",
                "description": "Exit code, 1 to 4."
              },
              "fix": {
                "description": "The command that fixes it.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "description": "One line for people.",
                "type": "string"
              },
              "reason": {
                "description": "Stable kebab-case reason.",
                "type": "string"
              }
            },
            "required": [
              "code",
              "reason",
              "message"
            ],
            "type": "object"
          },
          "Exit": {
            "description": "Exit code: 0 success, 1 usage, 2 system, 3 gate failed, 4 refused.",
            "maximum": 4,
            "minimum": 0,
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "properties": {
          "advice": {
            "items": {
              "$ref": "#/$defs/Advice"
            },
            "type": "array"
          },
          "error": {
            "$ref": "#/$defs/ErrorBody"
          }
        },
        "required": [
          "error",
          "advice"
        ],
        "type": "object"
      },
      "name": "proxy.status",
      "result": {
        "$defs": {
          "Advice": {
            "description": "One advice entry: a level, a short kebab-case `type` for programs to match\non, a message, and optionally the one command that follows it up.",
            "properties": {
              "command": {
                "description": "The command that acts on this advice, if any.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "level": {
                "$ref": "#/$defs/AdviceLevel",
                "description": "Level."
              },
              "message": {
                "description": "One line for people. For `next`, the command itself.",
                "type": "string"
              },
              "type": {
                "description": "Stable kebab-case identifier: `next`, `guessed-scope`, `gate-failed`.",
                "type": "string"
              }
            },
            "required": [
              "level",
              "type",
              "message"
            ],
            "type": "object"
          },
          "AdviceLevel": {
            "description": "How much an advice entry matters.",
            "oneOf": [
              {
                "const": "info",
                "description": "Something to know or do next.",
                "type": "string"
              },
              {
                "const": "warn",
                "description": "Something probably wrong or guessed.",
                "type": "string"
              },
              {
                "const": "error",
                "description": "Something failed (a gate, a partial batch).",
                "type": "string"
              }
            ]
          },
          "EngineInfo": {
            "description": "A running engine, as `proxy start`, `proxy status` and `version` show it.",
            "properties": {
              "build": {
                "description": "The engine's build (its `teapot` version).",
                "type": "string"
              },
              "control_socket": {
                "description": "The control socket.",
                "type": "string"
              },
              "enforced": {
                "description": "Whether the engine runs under playpen.",
                "type": "boolean"
              },
              "instance": {
                "description": "The engine instance ID (also in the lock file and the handshake).",
                "type": "string"
              },
              "listener": {
                "description": "The proxy listener, `address:port`.",
                "type": "string"
              },
              "mode": {
                "default": "regular",
                "description": "The listener mode it runs in: `regular`, `reverse:<url>` or\n`upstream:<url>` (bn-ouw4).",
                "type": "string"
              },
              "pass": {
                "default": null,
                "description": "The pass file the engine was started with, if any.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "pid": {
                "description": "The engine's process ID.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "policy_locked": {
                "description": "Whether the engine's policy is locked for its lifetime (plan 13).",
                "type": "boolean"
              },
              "project": {
                "description": "The project directory.",
                "type": "string"
              },
              "project_id": {
                "description": "The project ID.",
                "type": "string"
              },
              "started_at": {
                "description": "When the engine started, RFC 3339.",
                "type": "string"
              }
            },
            "required": [
              "instance",
              "pid",
              "project_id",
              "project",
              "listener",
              "control_socket",
              "started_at",
              "policy_locked",
              "enforced",
              "build"
            ],
            "type": "object"
          },
          "ProxyStatus": {
            "description": "The result of `teapot proxy status`.",
            "properties": {
              "engine": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/EngineInfo"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "The engine, when one runs."
              },
              "health": {
                "default": null,
                "description": "The engine's health snapshot (listener counters, flows, capture,\nstore writer, index backlog, pass, policy lock, browser listeners,\nprocess): always present when `running` is true, null when it is\nfalse. Should the snapshot ever fail to serialize, it is\n`{\"unavailable\": \"<why>\"}`, never left out."
              },
              "project": {
                "description": "The project directory.",
                "type": "string"
              },
              "running": {
                "description": "Whether an engine runs for the project.",
                "type": "boolean"
              }
            },
            "required": [
              "running",
              "project"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "advice": {
            "items": {
              "$ref": "#/$defs/Advice"
            },
            "type": "array"
          },
          "proxy": {
            "$ref": "#/$defs/ProxyStatus"
          }
        },
        "required": [
          "proxy",
          "advice"
        ],
        "type": "object"
      },
      "streaming": false,
      "summary": "Show the running engine and its health counters"
    }
  }
}
