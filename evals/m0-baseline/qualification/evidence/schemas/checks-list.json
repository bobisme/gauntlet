{
  "advice": [
    {
      "command": "teapot checks list --help",
      "level": "info",
      "message": "teapot checks list --help",
      "type": "next"
    }
  ],
  "schema": {
    "arguments": {
      "$defs": {
        "ChecksListArgs": {
          "description": "Arguments of `teapot checks list`.",
          "properties": {
            "kind": {
              "default": null,
              "description": "Only `passive` or only `active` checks.",
              "type": [
                "string",
                "null"
              ]
            },
            "profile": {
              "default": null,
              "description": "Only the checks a scan of this profile runs: `quick`, `standard`\n(quick and standard checks) or `thorough` (all).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        }
      },
      "$ref": "#/$defs/ChecksListArgs"
    },
    "command": "checks list",
    "destructive": 1,
    "effect": "read-only",
    "error": {
      "$defs": {
        "Advice": {
          "description": "One advice entry: a level, a short kebab-case `type` for programs to match\non, a message, and optionally the one command that follows it up.",
          "properties": {
            "command": {
              "description": "The command that acts on this advice, if any.",
              "type": [
                "string",
                "null"
              ]
            },
            "level": {
              "$ref": "#/$defs/AdviceLevel",
              "description": "Level."
            },
            "message": {
              "description": "One line for people. For `next`, the command itself.",
              "type": "string"
            },
            "type": {
              "description": "Stable kebab-case identifier: `next`, `guessed-scope`, `gate-failed`.",
              "type": "string"
            }
          },
          "required": [
            "level",
            "type",
            "message"
          ],
          "type": "object"
        },
        "AdviceLevel": {
          "description": "How much an advice entry matters.",
          "oneOf": [
            {
              "const": "info",
              "description": "Something to know or do next.",
              "type": "string"
            },
            {
              "const": "warn",
              "description": "Something probably wrong or guessed.",
              "type": "string"
            },
            {
              "const": "error",
              "description": "Something failed (a gate, a partial batch).",
              "type": "string"
            }
          ]
        },
        "ErrorBody": {
          "description": "The value under `error` in an error envelope. Published by `teapot schema`.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Exit",
              "description": "Exit code, 1 to 4."
            },
            "fix": {
              "description": "The command that fixes it.",
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "description": "One line for people.",
              "type": "string"
            },
            "reason": {
              "description": "Stable kebab-case reason.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "reason",
            "message"
          ],
          "type": "object"
        },
        "Exit": {
          "description": "Exit code: 0 success, 1 usage, 2 system, 3 gate failed, 4 refused.",
          "maximum": 4,
          "minimum": 0,
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "properties": {
        "advice": {
          "items": {
            "$ref": "#/$defs/Advice"
          },
          "type": "array"
        },
        "error": {
          "$ref": "#/$defs/ErrorBody"
        }
      },
      "required": [
        "error",
        "advice"
      ],
      "type": "object"
    },
    "name": "checks.list",
    "result": {
      "$defs": {
        "Advice": {
          "description": "One advice entry: a level, a short kebab-case `type` for programs to match\non, a message, and optionally the one command that follows it up.",
          "properties": {
            "command": {
              "description": "The command that acts on this advice, if any.",
              "type": [
                "string",
                "null"
              ]
            },
            "level": {
              "$ref": "#/$defs/AdviceLevel",
              "description": "Level."
            },
            "message": {
              "description": "One line for people. For `next`, the command itself.",
              "type": "string"
            },
            "type": {
              "description": "Stable kebab-case identifier: `next`, `guessed-scope`, `gate-failed`.",
              "type": "string"
            }
          },
          "required": [
            "level",
            "type",
            "message"
          ],
          "type": "object"
        },
        "AdviceLevel": {
          "description": "How much an advice entry matters.",
          "oneOf": [
            {
              "const": "info",
              "description": "Something to know or do next.",
              "type": "string"
            },
            {
              "const": "warn",
              "description": "Something probably wrong or guessed.",
              "type": "string"
            },
            {
              "const": "error",
              "description": "Something failed (a gate, a partial batch).",
              "type": "string"
            }
          ]
        },
        "CheckHealthView": {
          "description": "The passive-call health of a running check or lead rule (bn-gmw9).\n\nHow its passive calls have gone and whether the quarantine has stopped\nit. Present on a `checks list`/`checks show` row once a passive call has\nrun for the check that runs this id.",
          "properties": {
            "calls": {
              "description": "Passive calls the runner made for it (one per flow it applied to).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "consecutive_failures": {
              "description": "Failures in a row up to the last call.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "failures": {
              "description": "Calls that failed: a runtime error, a bad result, or a budget limit\n(an instruction or time limit), all counted the same.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "last_failure": {
              "description": "The reason word of the last failure (`error`, `timeout`,\n`instruction-limit`, `not-in-passive`, `bad-result`, ...); never a\nmessage.",
              "type": [
                "string",
                "null"
              ]
            },
            "quarantines": {
              "description": "Times it has been quarantined since the last `scripts reload`.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "state": {
              "description": "`running`, or `quarantined` (failed too often in a row; its row's\n`state` is then `disabled` and `reason` says why).",
              "type": "string"
            }
          },
          "required": [
            "state",
            "calls",
            "failures",
            "consecutive_failures",
            "quarantines"
          ],
          "type": "object"
        },
        "CheckOrigin": {
          "description": "Where a registration of a check is: place, script, file and line.",
          "properties": {
            "file": {
              "description": "The script's file; null for a built-in or bundled check.",
              "type": [
                "string",
                "null"
              ]
            },
            "line": {
              "description": "The line of the `t.check` call.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "script": {
              "description": "The script's name; null for a built-in check.",
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "description": "`builtin`, `bundled`, `user` or `project`.",
              "type": "string"
            }
          },
          "required": [
            "source"
          ],
          "type": "object"
        },
        "CheckRow": {
          "description": "One registration of a check, as `checks list` shows it.",
          "properties": {
            "confidence": {
              "description": "The default confidence: `tentative`, `firm` or `certain`.",
              "type": "string"
            },
            "file": {
              "description": "The script's file; null for a built-in or bundled check.",
              "type": [
                "string",
                "null"
              ]
            },
            "health": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CheckHealthView"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Its passive-call health (bn-gmw9).\n\nPresent once a passive call has run for the check that runs this id; a\nquarantined check's `state` is `disabled` and `reason` says why.\nAbsent for a check with no call and with no engine."
            },
            "id": {
              "description": "`<family>.<name>`.",
              "type": "string"
            },
            "kind": {
              "description": "`passive` or `active`.",
              "type": "string"
            },
            "line": {
              "description": "The line of the `t.check` call.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "profile": {
              "description": "The lowest scan profile that runs it: `quick`, `standard` or\n`thorough`.",
              "type": "string"
            },
            "reason": {
              "description": "Why it is in that state, when the state alone does not say it: which\ncheck it replaced, or which one replaced it.",
              "type": [
                "string",
                "null"
              ]
            },
            "replaced_by": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CheckOrigin"
                },
                {
                  "type": "null"
                }
              ],
              "description": "For `overridden` and `file-replaced`: the registration that runs\nfor this id instead (null when none does)."
            },
            "replaces": {
              "default": [],
              "description": "For the row that runs: the registrations of earlier places it\nreplaced (empty when none).",
              "items": {
                "$ref": "#/$defs/CheckOrigin"
              },
              "type": "array"
            },
            "script": {
              "description": "The script that registered it; null for a built-in check.",
              "type": [
                "string",
                "null"
              ]
            },
            "severity": {
              "description": "`info`, `low`, `medium`, `high` or `critical`.",
              "type": "string"
            },
            "source": {
              "description": "`builtin`, `bundled`, `user` or `project`.",
              "type": "string"
            },
            "state": {
              "description": "`enabled`, `overridden`, `file-replaced`, `conflict`, `not-loaded`\nor `disabled`.",
              "type": "string"
            },
            "title": {
              "description": "What a finding of it is called.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind",
            "title",
            "severity",
            "confidence",
            "profile",
            "source",
            "state"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "advice": {
          "items": {
            "$ref": "#/$defs/Advice"
          },
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckRow"
          },
          "type": "array"
        }
      },
      "required": [
        "checks",
        "advice"
      ],
      "type": "object"
    },
    "streaming": false,
    "summary": "List the passive and active checks, where each comes from, and which one runs"
  }
}
