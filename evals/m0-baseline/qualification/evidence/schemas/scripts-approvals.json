{
  "advice": [
    {
      "command": "teapot scripts approvals --help",
      "level": "info",
      "message": "teapot scripts approvals --help",
      "type": "next"
    }
  ],
  "schema": {
    "arguments": {
      "$defs": {
        "NoArgs": {
          "additionalProperties": false,
          "description": "Arguments of a command that takes none.",
