{
  "advice": [
    {
      "command": "teapot findings list --help",
      "level": "info",
      "message": "teapot findings list --help",
      "type": "next"
    }
  ],
  "schema": {
    "arguments": {
      "$defs": {
        "FindingsListArgs": {
          "description": "Arguments of `teapot findings list`.",
          "properties": {
            "after": {
              "default": null,
              "description": "Continue after this id: the `after` of the `next-page` advice of the\ncall before (same filters).",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "check": {
              "default": [],
              "description": "Only these check ids (`xss.reflected`); repeat or separate with commas.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "fail_on": {
              "default": null,
              "description": "Exit 3 (reason `findings`) when an open finding of this severity or\nworse matches the filters.",
              "type": [
                "string",
                "null"
              ]
            },
            "group": {
              "default": null,
              "description": "Only this group (a `group` value of a row).",
              "type": [
                "string",
                "null"
              ]
            },
            "host": {
              "default": null,
              "description": "Only this host (no case).",
              "type": [
                "string",
                "null"
              ]
            },
            "job": {
              "default": null,
              "description": "Only findings this job found (from `jobs list`).",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "limit": {
              "default": 50,
              "description": "Most rows, 1 to 1000.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "min_severity": {
              "default": null,
              "description": "Only this severity or worse.",
              "type": [
                "string",
                "null"
              ]
            },
            "severity": {
              "default": [],
              "description": "Only these severities (`info`, `low`, `medium`, `high`, `critical`);\nrepeat the flag or separate with commas.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "state": {
              "default": [],
              "description": "Only these states (`open`, `dismissed`, `fixed`, or `all`). Default:\n`open`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "ungrouped": {
              "default": false,
              "description": "One row per finding, not per group.",
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "$ref": "#/$defs/FindingsListArgs"
    },
    "command": "findings list",
    "destructive": 1,
    "effect": "read-only",
    "error": {
      "$defs": {
        "Advice": {
          "description": "One advice entry: a level, a short kebab-case `type` for programs to match\non, a message, and optionally the one command that follows it up.",
          "properties": {
            "command": {
              "description": "The command that acts on this advice, if any.",
              "type": [
                "string",
                "null"
              ]
            },
            "level": {
              "$ref": "#/$defs/AdviceLevel",
              "description": "Level."
            },
            "message": {
              "description": "One line for people. For `next`, the command itself.",
              "type": "string"
            },
            "type": {
              "description": "Stable kebab-case identifier: `next`, `guessed-scope`, `gate-failed`.",
              "type": "string"
            }
          },
          "required": [
            "level",
            "type",
            "message"
          ],
          "type": "object"
        },
        "AdviceLevel": {
          "description": "How much an advice entry matters.",
          "oneOf": [
            {
              "const": "info",
              "description": "Something to know or do next.",
              "type": "string"
            },
            {
              "const": "warn",
              "description": "Something probably wrong or guessed.",
              "type": "string"
            },
            {
              "const": "error",
              "description": "Something failed (a gate, a partial batch).",
              "type": "string"
            }
          ]
        },
        "ErrorBody": {
          "description": "The value under `error` in an error envelope. Published by `teapot schema`.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Exit",
              "description": "Exit code, 1 to 4."
            },
            "fix": {
              "description": "The command that fixes it.",
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "description": "One line for people.",
              "type": "string"
            },
            "reason": {
              "description": "Stable kebab-case reason.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "reason",
            "message"
          ],
          "type": "object"
        },
        "Exit": {
          "description": "Exit code: 0 success, 1 usage, 2 system, 3 gate failed, 4 refused.",
          "maximum": 4,
          "minimum": 0,
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "properties": {
        "advice": {
          "items": {
            "$ref": "#/$defs/Advice"
          },
          "type": "array"
        },
        "error": {
          "$ref": "#/$defs/ErrorBody"
        }
      },
      "required": [
        "error",
        "advice"
      ],
      "type": "object"
    },
    "name": "findings.list",
    "result": {
      "$defs": {
        "Advice": {
          "description": "One advice entry: a level, a short kebab-case `type` for programs to match\non, a message, and optionally the one command that follows it up.",
          "properties": {
            "command": {
              "description": "The command that acts on this advice, if any.",
              "type": [
                "string",
                "null"
              ]
            },
            "level": {
              "$ref": "#/$defs/AdviceLevel",
              "description": "Level."
            },
            "message": {
              "description": "One line for people. For `next`, the command itself.",
              "type": "string"
            },
            "type": {
              "description": "Stable kebab-case identifier: `next`, `guessed-scope`, `gate-failed`.",
              "type": "string"
            }
          },
          "required": [
            "level",
            "type",
            "message"
          ],
          "type": "object"
        },
        "AdviceLevel": {
          "description": "How much an advice entry matters.",
          "oneOf": [
            {
              "const": "info",
              "description": "Something to know or do next.",
              "type": "string"
            },
            {
              "const": "warn",
              "description": "Something probably wrong or guessed.",
              "type": "string"
            },
            {
              "const": "error",
              "description": "Something failed (a gate, a partial batch).",
              "type": "string"
            }
          ]
        },
        "FindingListRow": {
          "description": "One row of `findings list`: a finding, or with grouping a group of them.",
          "properties": {
            "check": {
              "description": "The check's id.",
              "type": "string"
            },
            "confidence": {
              "description": "`tentative`, `firm` or `certain`.",
              "type": "string"
            },
            "endpoints": {
              "description": "Distinct endpoints those findings are on.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "findings": {
              "description": "Findings in this row: 1 when ungrouped.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "fingerprint": {
              "description": "The finding's fingerprint (a group: the first finding's).",
              "type": "string"
            },
            "group": {
              "description": "The group key (check id and point name); null for none.",
              "type": [
                "string",
                "null"
              ]
            },
            "host": {
              "description": "The endpoint's host.",
              "type": "string"
            },
            "id": {
              "description": "The finding (a group: its first finding), for `findings show`.",
              "format": "int64",
              "type": "integer"
            },
            "ids": {
              "description": "The ids of those findings, at most 20 (the first is `id`).",
              "items": {
                "format": "int64",
                "type": "integer"
              },
              "type": "array"
            },
            "last_seen": {
              "description": "When it was last seen (RFC 3339).",
              "type": "string"
            },
            "method": {
              "description": "The endpoint's method.",
              "type": "string"
            },
            "path": {
              "description": "The endpoint's path template.",
              "type": "string"
            },
            "point": {
              "description": "The point's name; null for the endpoint as a whole.",
              "type": [
                "string",
                "null"
              ]
            },
            "seen": {
              "description": "How many times it was found (a group: the first finding's).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "severity": {
              "description": "`info`, `low`, `medium`, `high` or `critical` (a group: the worst).",
              "type": "string"
            },
            "state": {
              "description": "`open`, `dismissed` or `fixed`.",
              "type": "string"
            },
            "title": {
              "description": "What the finding is called.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "fingerprint",
            "check",
            "severity",
            "confidence",
            "state",
            "title",
            "host",
            "method",
            "path",
            "seen",
            "findings",
            "endpoints",
            "ids",
            "last_seen"
          ],
          "type": "object"
        },
        "FindingsListed": {
          "description": "What `findings list` returns.",
          "properties": {
            "counts": {
              "$ref": "#/$defs/SeverityCounts",
              "description": "The matches by severity."
            },
            "failing": {
              "description": "Open findings at or above `--fail-on`; null without it.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "grouped": {
              "description": "Rows are groups.",
              "type": "boolean"
            },
            "groups": {
              "description": "Groups the filters match; null when ungrouped.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "more": {
              "description": "More rows follow: the `next-page` advice has the command.",
              "type": "boolean"
            },
            "rows": {
              "description": "The page.",
              "items": {
                "$ref": "#/$defs/FindingListRow"
              },
              "type": "array"
            },
            "total": {
              "description": "Findings the filters match (every page).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "grouped",
            "total",
            "counts",
            "more",
            "rows"
          ],
          "type": "object"
        },
        "SeverityCounts": {
          "description": "How many findings match, by severity.",
          "properties": {
            "critical": {
              "description": "Critical findings.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "high": {
              "description": "High findings.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "info": {
              "description": "Informational findings.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "low": {
              "description": "Low findings.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "medium": {
              "description": "Medium findings.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "advice": {
          "items": {
            "$ref": "#/$defs/Advice"
          },
          "type": "array"
        },
        "findings": {
          "$ref": "#/$defs/FindingsListed"
        }
      },
      "required": [
        "findings",
        "advice"
      ],
      "type": "object"
    },
    "streaming": false,
    "summary": "List findings, duplicates grouped, with counts by severity"
  }
}
